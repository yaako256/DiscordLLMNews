# .config/prod/.env.example
# 本番用envファイル
# app.prod.tomlを上書きできる。
# APP__PATHS__DATA_DIR_PATH形式を採用

# discordのwebhookを上書き
# `,`で複数webhookを指定できる
# 通知用webhook
APP__DISCORD__NOTIFY_WEBHOOK=WEBHOOK1,WEBHOOK2
# ログ通知用webhook
APP__DISCORD__LOGS_WEBHOOK=WEBHOOK1,WEBHOOK2


# ""で囲うと1行判定されるため、このようにも指定できる
# 1つ目の " は = の後ろに書かないと怒られる
# APP__DISCORD__NOTIFY_WEBHOOK="
#   WEBHOOK1,
#   WEBHOOK2
#   "
# APP__DISCORD__LOGS_WEBHOOK="
#   WEBHOOK1,
#   WEBHOOK2
#   "